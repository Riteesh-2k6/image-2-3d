# GeoPrior Inference Worker Dockerfile
# Base image with full CUDA 12.1 Development Toolkit + PyTorch 2.4.0
FROM pytorch/pytorch:2.4.0-cuda12.1-cudnn9-devel

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1
ENV TORCH_CUDA_ARCH_LIST="8.6"
ENV PYTORCH_CUDA_ALLOC_CONF="max_split_size_mb:128"

# Install system dependencies & C++ build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    ninja-build \
    libgl1 \
    libglib2.0-0 \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Install Python requirements and compile gsplat with native CUDA extensions
RUN pip install --no-cache-dir --upgrade pip setuptools wheel && \
    pip install --no-cache-dir \
    ninja \
    psutil \
    opencv-python-headless \
    open3d \
    trimesh \
    xatlas \
    osqp \
    jaxtyping \
    rich \
    gsplat

# Copy project source into container
COPY . /workspace

CMD ["python", "benchmarks/run_b1_b2.py", "--views", "120", "--resolution", "1280x720", "--steps", "1000"]
